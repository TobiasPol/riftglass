    },
    "No builds available – OP.GG is unreachable and the client has no recommendation.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Builds verfügbar – OP.GG ist nicht erreichbar und der Client liefert keine Empfehlung."
          }
        }
      }
    },
    "No connection to the League client.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Verbindung zum League-Client."
          }
        }
      }
    },
    "No data": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Daten"
          }
        }
      }
    },
    "No free rune page slot. Delete a page in the client – Riftglass only replaces its own pages.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein freier Runenseiten-Platz. Lösche eine Seite im Client – Riftglass ersetzt nur eigene Seiten."
          }
        }
      }
    },
    "OP.GG": {
      "shouldTranslate": false
    },
    "OP.GG statistics · ⌥A hides": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "OP.GG-Statistik · ⌥A blendet aus"
          }
        }
      }
    },
    "Only from visible items. Whether Riot allows this is unclear – so it is off by default.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur aus sichtbaren Items. Ob Riot das erlaubt, ist ungeklärt – daher standardmäßig aus."
          }
        }
      }
    },
    "Only reads local interfaces of the League client (LCU, Live Client Data API). No memory reading, no injection, no input automation, no telemetry. Builds and ranks: OP.GG. Riftglass only changes its own rune pages and item sets.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Liest nur lokale Schnittstellen des League-Clients (LCU, Live Client Data API). Kein Speicherlesen, keine Injection, keine Eingabe-Automatisierung, keine Telemetrie. Builds und Ränge: OP.GG. Riftglass ändert nur eigene Runenseiten und Item-Sets."
          }
        }
      }
    },
    "Only uses champions you can see in champ select. Enemy lanes are estimated from OP.GG statistics; counter picks only appear during your pick.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nutzt nur Champions, die du im Champ Select siehst. Gegner-Lanes werden aus OP.GG-Statistiken geschätzt, Counter-Picks erscheinen nur während deines Picks."
          }
        }
      }
    },
    "Open System Settings": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Systemeinstellungen öffnen"
